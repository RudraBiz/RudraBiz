// ============================================================
// Accounting App — Prisma Schema
// Layer scope for this pass: Global Users, Companies,
// Company-User access, and Master (lookup) tables only.
// No transactional/File tables (invoices, journal entries, etc.) yet.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}
// ============================================================
// GLOBAL LAYER
// ============================================================

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  companyUsers     CompanyUser[] @relation("CompanyUserAccount")
  invitedUsers     CompanyUser[] @relation("CompanyUserInvitedBy")
  oauthAccounts    OAuthAccount[]
  sessions         Session[]
  createdJournalEntries JournalEntry[]

  @@map("users")
}

// ============================================================
// AUTH (NextAuth.js / Auth.js) — Pass 2
//
// Named OAuthAccount (not "Account") to avoid colliding with the
// Chart of Accounts "Account" model added in Pass 4 — both would
// otherwise map to a table named "accounts". Not currently wired to
// an adapter (session strategy is JWT, Credentials provider only),
// so these tables exist but aren't populated by anything yet — this
// rename is safe.
// ============================================================

model OAuthAccount {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ============================================================
// COMPANY (the container / workspace)
// ============================================================

model Company {
  id                 String  @id @default(uuid())
  name               String
  slug               String  @unique
  legalName          String?
  registrationNumber String?
  taxId              String?
  industry           String?
  website            String?
  email              String?
  phone              String?

  // Address
  addressLine String?
  city        String?
  state       String?
  zip         String?

  logoUrl String?

  // Accounting settings
  fiscalYearStartMonth Int     @default(1) // 1-12
  decimalPrecision     Int     @default(2)

  // Tax settings
  taxRegistered        Boolean @default(false)
  defaultTaxRateId     String?

  // Books control
  booksLockedUntil DateTime?

  plan String @default("free")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Master table references
  companyTypeId       String
  companyType         CompanyType  @relation(fields: [companyTypeId], references: [id])

  countryId           String
  country              Country      @relation(fields: [countryId], references: [id])

  baseCurrencyId       String
  baseCurrency         Currency     @relation(fields: [baseCurrencyId], references: [id])

  accountingMethodId   String
  accountingMethod     AccountingMethod @relation(fields: [accountingMethodId], references: [id])

  taxFilingFrequencyId String?
  taxFilingFrequency   TaxFilingFrequency? @relation(fields: [taxFilingFrequencyId], references: [id])

  companyStatusId      String
  companyStatus        CompanyStatus @relation(fields: [companyStatusId], references: [id])

  // Relations
  companyUsers CompanyUser[]
  accounts     Account[]
  journalEntries JournalEntry[]

  @@map("companies")
}

// ============================================================
// COMPANY <-> USER ACCESS (multi-tenant backbone)
// One row per (userId, companyId) — single role per company.
// ============================================================

model CompanyUser {
  id        String @id @default(uuid())

  userId    String
  user      User   @relation("CompanyUserAccount", fields: [userId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  companyUserRoleId String
  role              CompanyUserRole @relation(fields: [companyUserRoleId], references: [id])

  isDefault Boolean @default(false)

  invitedById String?
  invitedBy   User?   @relation("CompanyUserInvitedBy", fields: [invitedById], references: [id])

  joinedAt DateTime @default(now())

  @@unique([userId, companyId]) // enforces: one role per user per company
  @@map("company_users")
}

// ============================================================
// MASTER TABLES (lookup/reference data)
// ============================================================

model CompanyType {
  id        String  @id @default(uuid())
  name      String  // e.g. "Limited Liability Company"
  code      String  @unique // e.g. "LLC"
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  companies Company[]

  @@map("master_company_types")
}

model Country {
  id       String  @id @default(uuid())
  name     String  // e.g. "Nepal"
  isoCode  String  @unique // e.g. "NP"
  isActive Boolean @default(true)

  companies Company[]

  @@map("master_countries")
}

model Currency {
  id            String  @id @default(uuid())
  name          String  // e.g. "Nepalese Rupee"
  isoCode       String  @unique // e.g. "NPR"
  symbol        String  // e.g. "रू"
  decimalPlaces Int     @default(2)
  isActive      Boolean @default(true)

  companies Company[]

  @@map("master_currencies")
}

model AccountingMethod {
  id          String  @id @default(uuid())
  name        String  // e.g. "Accrual"
  code        String  @unique // e.g. "ACCRUAL"
  description String?
  isActive    Boolean @default(true)

  companies Company[]

  @@map("master_accounting_methods")
}

model TaxFilingFrequency {
  id       String  @id @default(uuid())
  name     String  // e.g. "Quarterly"
  code     String  @unique // e.g. "QUARTERLY"
  isActive Boolean @default(true)

  companies Company[]

  @@map("master_tax_filing_frequencies")
}

model CompanyStatus {
  id       String  @id @default(uuid())
  name     String  // e.g. "Active"
  code     String  @unique // e.g. "ACTIVE"
  isActive Boolean @default(true)

  companies Company[]

  @@map("master_company_statuses")
}

model CompanyUserRole {
  id       String  @id @default(uuid())
  name     String  // e.g. "Accountant"
  code     String  @unique // e.g. "ACCOUNTANT"
  isActive Boolean @default(true)

  companyUsers CompanyUser[]

  @@map("master_company_user_roles")
}

model AccountType {
  id            String  @id @default(uuid())
  name          String  // e.g. "Asset"
  code          String  @unique // e.g. "ASSET"
  normalBalance String  // "DEBIT" or "CREDIT" — which side increases this type
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)

  accounts Account[]

  @@map("master_account_types")
}

// ============================================================
// CHART OF ACCOUNTS (per company) — Pass 4
// ============================================================

model Account {
  id        String  @id @default(uuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  code String // account number, e.g. "1000" — unique per company
  name String
  description String?

  accountTypeId String
  accountType   AccountType @relation(fields: [accountTypeId], references: [id])

  parentAccountId String?
  parent          Account?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  children        Account[] @relation("AccountHierarchy")

  // System accounts (e.g. Retained Earnings) are created automatically
  // per company and shouldn't be deletable/renamable from the UI.
  isSystemAccount Boolean @default(false)
  isActive        Boolean @default(true)

  // Opening balances are recorded as plain fields for now rather than a
  // journal entry, since journal entries don't exist yet (Pass 5). Once
  // they do, these may get migrated into an opening-balance journal entry
  // instead — but that's a later, separate migration.
  openingBalance     Decimal   @default(0) @db.Decimal(18, 2)
  openingBalanceAsOf DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalEntryLines JournalEntryLine[]

  @@unique([companyId, code])
  @@map("accounts")
}

// ============================================================
// LEDGER CORE (double-entry journal) — Pass 5
//
// Journal entries are immutable once created — there's no edit/delete.
// To correct a mistake, reverse the entry (creates a new entry with
// debits/credits swapped, linked back to the original). This matches
// how real double-entry bookkeeping handles corrections: you never
// rewrite history, you post an offsetting entry.
// ============================================================

model JournalEntry {
  id String @id @default(uuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Human-readable, sequential per company (e.g. "JE-0001"). Generated
  // from a per-company count at creation time — see note in actions.ts
  // about the race condition this implies under concurrent submits.
  entryNumber String

  entryDate   DateTime
  description String?
  reference   String? // e.g. invoice #, check #, external doc reference

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  // If this entry reverses another one, this points at the original.
  // @unique enforces that an original entry can only be reversed once.
  reversedEntryId String?      @unique
  reversedEntry   JournalEntry? @relation("JournalEntryReversal", fields: [reversedEntryId], references: [id])
  reversalEntry   JournalEntry? @relation("JournalEntryReversal")

  createdAt DateTime @default(now())

  lines JournalEntryLine[]

  @@unique([companyId, entryNumber])
  @@map("journal_entries")
}

model JournalEntryLine {
  id String @id @default(uuid())

  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  // Exactly one of debit/credit should be > 0, the other 0 — enforced in
  // application logic (see actions.ts), not a DB constraint.
  debit  Decimal @default(0) @db.Decimal(18, 2)
  credit Decimal @default(0) @db.Decimal(18, 2)

  description String?
  lineOrder   Int     @default(0)

  @@map("journal_entry_lines")
}
